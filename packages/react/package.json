{
  "name": "@mob3/react",
  "version": "0.1.0",
  "description": "React bindings for mob3 \u2014 Strict Mode\u2013safe App lifecycle",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@mob3/core": "0.1.0",
    "@mob3/three": "0.1.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "three": "^0.174.0"
  },
  "peerDependenciesMeta": {
    "@mob3/three": {
      "optional": true
    },
    "three": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mob3/core": "0.1.0",
    "@mob3/three": "0.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "three": "^0.174.0",
    "@types/three": "^0.174.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theelevators/mob3.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/theelevators/mob3#readme",
  "bugs": {
    "url": "https://github.com/theelevators/mob3/issues"
  },
  "license": "MIT",
  "keywords": [
    "mob3",
    "ecs",
    "react",
    "three.js"
  ]
}
