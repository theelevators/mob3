{
  "name": "mob3",
  "version": "0.1.0",
  "description": "ECS application architecture for Three.js \u2014 without replacing Three.js",
  "type": "module",
  "main": "./dist/browser.js",
  "module": "./dist/browser.js",
  "types": "./dist/browser.d.ts",
  "exports": {
    ".": {
      "types": "./dist/browser.d.ts",
      "browser": "./dist/browser.js",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./parallel": {
      "types": "./dist/parallel/public.d.ts",
      "import": "./dist/parallel/public.js"
    },
    "./abi": {
      "types": "./dist/abi/public.d.ts",
      "import": "./dist/abi/public.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/parallel dist/abi && cp src/parallel/*.mjs dist/parallel/ && cp src/abi/*.mjs dist/abi/ && mkdir -p dist/../tests/fixtures/wasm 2>/dev/null; true",
    "compile:wat": "node scripts/compile-wat.mjs",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "ecs",
    "entity-component-system",
    "three.js",
    "game",
    "typescript"
  ],
  "license": "MIT"
}
